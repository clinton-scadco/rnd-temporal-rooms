# The second design everybody builds: if one of each made 54 MW, four of each
# will make four times as much.
#
# It does, roughly. It also needs a second pump, two heat mains six tiles long
# to reach the far half of the plot, and nineteen times the land. The mains are
# where the sprawl shows up as a number rather than as a shape: distance is
# charged a percent a tile, so the two exchangers at the bottom of the plot get
# six percent less heat than the two bolted to the reactor -- for no reason
# except that they are down there. Compare it with 03-compact, which makes half
# as much power on a quarter of the plot and wastes nothing at all.

machine "More Of Everything"

reactor   R1  at 0,0

exchanger HX1 at 5,0
turbine   T1  at 9,0
generator G1  at 13,0

exchanger HX2 at 5,4
turbine   T2  at 9,4
generator G2  at 13,4

pump      W1  at 1,5

exchanger HX3 at 0,10
turbine   T3  at 0,14
generator G3  at 0,17

exchanger HX4 at 4,10
turbine   T4  at 4,14
generator G4  at 4,17

pump      W2  at 8,10

wire R1.heat -> HX1.heat
wire R1.heat -> HX2.heat
wire R1.heat -> HX3.heat
wire R1.heat -> HX4.heat

wire W1.water -> HX1.water
wire W1.water -> HX2.water
wire W2.water -> HX3.water
wire W2.water -> HX4.water

wire HX1.steam -> T1.steam
wire HX2.steam -> T2.steam
wire HX3.steam -> T3.steam
wire HX4.steam -> T4.steam

wire T1.rotary -> G1.rotary
wire T2.rotary -> G2.rotary
wire T3.rotary -> G3.rotary
wire T4.rotary -> G4.rotary
